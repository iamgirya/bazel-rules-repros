bazel_dep(name = "rules_swift_package_manager", version = "1.26.0")
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_swift", version = "4.3.0")
bazel_dep(name = "rules_apple", version = "5.4.0")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    registries = "//:registries.json",
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
swift_deps.configure_package(
    name = "apple.swift-collections",
    patch_args = ["-p1"],
    patches = ["//patches:collections_marker.patch"],
)
use_repo(swift_deps, "swiftpkg_apple.swift_collections")
